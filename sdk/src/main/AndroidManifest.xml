<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="eu.darken.porter.permission.API" />

    <queries>
        <package android:name="eu.darken.porter" />
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="af.shizuku.plus.api" />
    </queries>

    <application>
        <provider
            android:name="eu.darken.porter.sdk.PorterApiProvider"
            android:authorities="${applicationId}.porter.api"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
