<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="eu.darken.porter" />
        <package android:name="moe.shizuku.privileged.api" />
    </queries>
    <application android:name=".ConsumerApplication" android:label="Porter SDK consumer">
        <provider android:name="eu.darken.porter.client.PorterProvider"
            android:authorities="${applicationId}.porter" android:exported="true"
            android:multiprocess="false" android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <provider android:name="eu.darken.porter.client.SelectedShizukuProvider"
            android:authorities="${applicationId}.shizuku" android:exported="true"
            android:multiprocess="false" android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
