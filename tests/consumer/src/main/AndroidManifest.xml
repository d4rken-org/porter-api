<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="eu.darken.porter" />
        <package android:name="moe.shizuku.privileged.api" />
    </queries>
    <application android:name=".ConsumerApplication" android:label="Porter SDK consumer">
        <!-- Declared so R8 keeps it: without a manifest component nothing reaches
             ShizukuProtocolDelivery and the consumer-rules.pro rule under test is never used. -->
        <provider
            android:name="eu.darken.porter.sdk.PorterShizukuApiProvider"
            android:authorities="${applicationId}.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
